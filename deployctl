WORKFLOW_TEMPLATE = """\
# deployctl이 생성한다. 사이트 정의는 ~/srv/{name}/app.json 에 있다.
name: Deploy {name}

on:
  push:
    branches: [{branch}]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: {name}-production
  cancel-in-progress: false

jobs:
  deploy:
    name: Build and deploy {name}
    # 사이트명 라벨로 이 맥의 전용 러너를 특정한다 (규칙 8-2).
    runs-on: [self-hosted, macOS, ARM64, {name}]
    timeout-minutes: 30

    steps:
      # 재부팅 직후 러너가 colima(도커 VM)보다 먼저 뜰 수 있다.
      - name: Wait for docker daemon
        run: |
          for _ in $(seq 60); do
            docker info >/dev/null 2>&1 && exit 0
            sleep 2
          done
          echo "docker daemon not ready" >&2
          exit 1

      - name: Check out source
        uses: actions/checkout@v6

      # 검사 → 빌드 → 기동 → Caddy 등록 → HTTPS 확인까지 deployctl 이 한다.
      - name: Deploy
        run: deployctl deploy {name} --source "$GITHUB_WORKSPACE"
"""


def default_branch(checkout):
    head = run(["git", "symbolic-ref", "--quiet", "--short", "HEAD"],
               check=False, cwd=str(checkout))
    return head or "main"


def write_workflow(name, checkout, force=False):
    """러너에서 도는 배포 워크플로를 만든다. git 이 이전 판을 들고 있어 백업은 남기지 않는다."""
    path = Path(checkout) / ".github" / "workflows" / "deploy.yml"
    text = WORKFLOW_TEMPLATE.format(name=name, branch=default_branch(checkout))
    if path.exists() and path.read_text() == text:
        print("  워크플로: 변동 없음 (%s)" % path)
        return path, False
    if path.exists() and not force:
        # 사람이 넣은 단계(테스트 게이트 같은)를 말없이 지우지 않는다.
        print("  워크플로: 이미 있습니다 — 건드리지 않습니다 (%s)" % path)
        print("           덮어쓰려면 deployctl workflow %s --force" % name)
        return path, False
    path.parent.mkdir(parents=True, exist_ok=True)
    verb = "갱신" if path.exists() else "생성"
    path.write_text(text)
    print("  워크플로 %s: %s" % (verb, path))
    return path, True


def stale_workflows(checkout):
    """이 사이트의 배포와 부딪힐 수 있는 다른 워크플로."""
    wf_dir = Path(checkout) / ".github" / "workflows"
    if not wf_dir.exists():
        return []
    return [path for path in sorted(wf_dir.glob("*.y*ml"))
            if path.name != "deploy.yml" and "self-hosted" in path.read_text(errors="replace")]


