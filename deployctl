def clone_cmd(url, path):
    """받아 올 명령. github 저장소는 gh 로 받는다 — 계정에 설정된 프로토콜을 그대로 쓴다."""
    slug_match = re.match(r"https?://github\.com/([^/]+/[^/.]+)", url or "")
    if slug_match and shutil.which("gh"):
        return ["gh", "repo", "clone", slug_match.group(1), str(path)]
    return ["git", "clone", url, str(path)]


def clone_repo(name, url):
    """규칙 7-1. 작업 공간에 소스를 받아 둔다. 이미 있으면 그대로 쓴다."""
    path = WORKSPACES / name
    if path.exists():
        print("  작업 공간: %s (이미 있음)" % path)
        return path
    if not url:
        return None
    path.parent.mkdir(parents=True, exist_ok=True)
    cmd = clone_cmd(url, path)
    print("  clone: %s" % " ".join(cmd))
    try:
        run(cmd, capture=False)
    except DeployError as exc:
        print("  clone 실패: %s" % str(exc).splitlines()[0])
        return None
    print("  작업 공간: %s" % path)
    return path


def put_env(name, key, value):
    """사이트 .env 에 키를 넣는다. 이미 있으면 건드리지 않는다."""
    env_file = site_dir(name) / ".env"
    if env_file.exists():
        lines = env_file.read_text().splitlines()
    else:
        lines = ["# %s 운영 설정. git에 올리지 않는다." % name]
    if any(line.split("=", 1)[0].strip() == key for line in lines if "=" in line):
        return False
    lines.append("%s=%s" % (key, value))
    write_atomic(env_file, "\n".join(lines) + "\n", mode=0o600)
    return True


