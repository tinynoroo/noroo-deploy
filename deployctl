def cmd_init(args):
    # 이름과 도메인이 둘 다 오면 예전처럼 조용히 돈다. 하나라도 빠지면 물어본다.
    if args.name is None or args.domain is None:
        if not sys.stdin.isatty():
            raise DeployError("대화형으로 물을 수 없는 환경입니다. "
                              "<사이트명> 과 --domain 을 인자로 주세요.")
        prompt_init(args)
    args.repo = args.repo or ""
    args.compose = args.compose or "source:compose.yaml"
    args.health_path = args.health_path or "/"
    args.pool = args.pool or DEFAULT_POOL

    name = args.name
    if not NAME_RE.match(name):
        raise DeployError("사이트명은 소문자·숫자·하이픈만 씁니다: %s" % name)
    sites = all_sites()
    if name in sites and not args.force:
        raise DeployError("이미 등록된 사이트입니다: %s (--force 로 덮어쓰기)" % name)
    for other, s in sites.items():
        if other != name and s.get("domain") == args.domain:
            raise DeployError("도메인이 이미 사용 중입니다: %s (%s)" % (args.domain, other))

    taken = {s.get("port") for n, s in sites.items() if n != name}
    port = args.port or allocate_port(taken)
    if port in taken:
        raise DeployError("포트가 이미 사용 중입니다: %s" % port)

    app = {
        "name": name,
        "domain": args.domain,
        "port": port,
        "healthPath": args.health_path,
        "repository": args.repo or "",
        "composeFile": args.compose,
        "poolSize": args.pool,
    }
    if args.max_upload:
        app["maxUploadMB"] = args.max_upload
    write_atomic(manifest_path(name), json.dumps(app, indent=2, ensure_ascii=False) + "\n")
    print("매니페스트: %s" % manifest_path(name))
    print("  도메인 %s · 포트 %d · 풀 %d" % (app["domain"], app["port"], app["poolSize"]))

    checkout = None if args.no_clone else clone_repo(name, app["repository"])

    if checkout:
        ref = app.get("composeFile", "source:compose.yaml")
        compose_path = (checkout / ref.split(":", 1)[1] if ref.startswith("source:")
                        else site_dir(name) / ref)
        missing = [p.name for p in (checkout / "Dockerfile", compose_path) if not p.exists()]
        if missing:
            print("  없는 파일: %s" % ", ".join(missing))
            wanted = args.scaffold
            if wanted is None and sys.stdin.isatty():
                wanted = ask_yes("claude 로 초안을 만들고 빌드로 검증할까요? "
                                 "(초안이므로 검수한 뒤 커밋하세요)", default=True)
            if wanted:
                try:
                    scaffold(name, app, checkout)
                except DeployError as exc:
                    print("  스캐폴딩 실패: %s" % exc)

    if checkout:
        write_workflow(name, checkout)
        for stale in stale_workflows(checkout):
            print("  확인 필요: %s 도 self-hosted 러너를 씁니다." % stale)

    runner_path = None
    if args.runner:
        try:
            runner_path = runner_install(name, app)
        except DeployError as exc:
            print("  러너 등록 실패: %s" % exc)
            print("  나중에 다시: deployctl runner %s" % name)

    env_file = site_dir(name) / ".env"
    if args.db:
        url = provision_db(name, app)
        if url:
            full = "%s?connection_limit=%d" % (url, app["poolSize"])
            if put_env(name, "DATABASE_URL", full):
                print("  DATABASE_URL 기록: %s (600)" % env_file)
            else:
                print("  DATABASE_URL 이 이미 있어 두었습니다. 새 값:\n    %s" % full)
    if not env_file.exists():
        write_atomic(env_file, "# %s 운영 설정. git에 올리지 않는다.\n" % name, mode=0o600)
        print("  환경 파일 생성: %s (600)" % env_file)

    if args.deploy and checkout:
        print()
        local_ok = True
        if runner_path and args.push is not False:
            print("[배포] push 해서 러너가 하게 합니다")
            done, may_fallback = deploy_by_push(name, app, checkout)
            if done:
                print("\n배포 완료: https://%s%s" % (app["domain"], app.get("healthPath", "/")))
                print("이제 %s 에 push할 때마다 자동 배포됩니다." % default_branch(checkout))
                return 0
            if not may_fallback:
                return 1
            print("  로컬 배포로 물러섭니다")
        elif runner_path:
            print("[배포] 여기서 합니다 (--no-push)")
        else:
            print("[배포] 러너가 없어 여기서 합니다")

        rc = cmd_deploy(argparse.Namespace(name=name, source=str(checkout), no_build=False,
                                           timeout=180, quiet=False, no_rollback=False))
        if rc == 0:
            print("\n배포 완료: https://%s%s" % (app["domain"], app.get("healthPath", "/")))
            print("자동 배포는 아직입니다. 검수한 뒤 미세요:")
            print("  cd %s && git add -A && git commit && git push" % checkout)
        return rc

    print("\n다음 순서")
    steps = []
    if not checkout:
        steps.append("소스를 받습니다: %s"
                     % " ".join(clone_cmd(app["repository"], WORKSPACES / name)))
    compose_ref = app.get("composeFile", "")
    compose_hint = (WORKSPACES / name / compose_ref.split(":", 1)[1]
                    if compose_ref.startswith("source:") else site_dir(name) / compose_ref)
    steps.append("%s 의 ports 를 \"127.0.0.1:%d:<컨테이너포트>\" 로 맞춥니다."
                 % (compose_hint, app["port"]))
    steps.append("앱이 쓸 나머지 시크릿을 %s 에 넣습니다." % env_file)
    if not runner_path:
        steps.append("러너를 붙입니다: deployctl runner %s" % name)
    steps.append("deployctl validate %s" % name)
    steps.append("deployctl deploy   %s" % name)
    for i, line in enumerate(steps, 1):
        print("  %d. %s" % (i, line))
    return 0


def cmd_validate(args):
    print("검사: %s" % args.name)
    validate(args.name, args.source)
    print("전부 통과")
    return 0


def cmd_deploy(args):
    name = args.name
    source = args.source or str(WORKSPACES / name)
    described = describe_source(source)
    if described:
        print("배포 대상: %s" % described[0])
        print("           %s" % described[1])

    print("[1/5] 검사")
    app = validate(name, args.source, quiet=args.quiet)
    base = compose_args(name, app, args.source)
    services = (compose_config(name, app, args.source).get("services") or {})
    # 빌드 직전 이미지를 기억해 둔다. 헬스체크가 실패하면 여기로 되돌린다.
    snapshot = {} if args.no_rollback else snapshot_images(built_images(services))

    if not args.no_build:
        print("[2/5] 이미지 빌드")
        run(base + ["build"], capture=False)
    else:
        print("[2/5] 빌드 건너뜀")

    print("[3/5] 컨테이너 기동")
    run(base + ["up", "-d", "--remove-orphans"] + (["--no-build"] if args.no_build else []),
        capture=False)

    print("[4/5] Caddy 사이트 등록")
    changed = write_site(app)
    caddy_reload()
    print("     %s · reload 완료" % ("사이트 파일 갱신" if changed else "사이트 파일 변동 없음"))

    print("[5/5] HTTPS 확인")
    url = "https://%s%s" % (app["domain"], app.get("healthPath", "/"))
    ok, last = poll_https(url, args.timeout)
    if ok:
        return 0

    print("     실패: %s" % last)
    if args.no_rollback:
        raise DeployError("HTTPS 확인이 %d초 안에 끝나지 않았습니다. 마지막 응답: %s"
                          % (args.timeout, last))
    print("[롤백] 이전 이미지로 되돌립니다")
    if not rollback(base, snapshot):
        raise DeployError("배포가 실패했고 되돌릴 이미지도 없습니다. 마지막 응답: %s" % last)
    ok, after = poll_https(url, 60)
    if ok:
        raise DeployError("새 버전이 응답하지 않아 이전 이미지로 되돌렸습니다. "
                          "사이트는 살아 있습니다. 실패 응답: %s\n"
                          "  주의: 마이그레이션은 되돌아가지 않습니다." % last)
    raise DeployError("배포도 롤백도 응답을 못 받았습니다. 배포 실패: %s / 롤백 후: %s"
                      % (last, after))


def poll_https(url, timeout):
    """(성공 여부, 마지막 응답). 4xx 도 앱이 살아 있는 것으로 본다."""
    deadline = time.time() + timeout
    last = ""
    while time.time() < deadline:
        try:
            req = urllib.request.Request(url, method="GET")
            with urllib.request.urlopen(req, timeout=10) as r:
                print("     %s → HTTP %d" % (url, r.status))
                return True, "HTTP %d" % r.status
        except urllib.error.HTTPError as e:
            if e.code < 500:
                print("     %s → HTTP %d" % (url, e.code))
                return True, "HTTP %d" % e.code
            last = "HTTP %d" % e.code
        except Exception as e:
            last = str(e)
        time.sleep(3)
    return False, last


def cmd_status(args):
    sites = all_sites()
    if args.name:
        sites = {args.name: load(args.name)}
    if not sites:
        print("등록된 사이트가 없습니다.")
        return 0
    hosts = caddy_hosts()
    limit, need = connection_headroom(all_sites())
    print("Caddy: %s" % ("응답 없음" if hosts is None else "%d개 사이트 로드됨" % len(hosts)))
    print("커넥션: %d 필요 / %d 상한\n" % (need, limit))
    for name, app in sorted(sites.items()):
        ps = run(["docker", "ps", "--filter", "label=com.docker.compose.project=%s" % name,
                  "--format", "{{.Names}}\t{{.Status}}"], check=False)
        running = len([l for l in ps.splitlines() if l.strip()])
        served = hosts is not None and app["domain"] in hosts
        code = ""
        try:
            with urllib.request.urlopen("https://%s%s" % (app["domain"], app.get("healthPath", "/")),
                                        timeout=10) as r:
                code = str(r.status)
        except urllib.error.HTTPError as e:
            code = str(e.code)
        except Exception:
            code = "실패"
        print("%s" % name)
        print("  도메인 %s (Caddy %s) · HTTPS %s" % (app["domain"], "등록" if served else "미등록", code))
        print("  포트 127.0.0.1:%s · 컨테이너 %d개" % (app["port"], running))
        state = runner_status(name, app)
        if state:
            print("  러너 mac-%s · %s" % (name, state))
        for line in ps.splitlines():
            if line.strip():
                print("    %s" % line.replace("\t", "  "))
    return 0


def cmd_scaffold(args):
    name = args.name
    app = load(name)
    checkout = Path(args.source) if args.source else WORKSPACES / name
    if not checkout.exists():
        raise DeployError("체크아웃이 없습니다: %s" % checkout)
    made = scaffold(name, app, checkout, force=args.force, attempts=args.attempts)
    if not made:
        print("만들 것이 없었습니다.")
        return 0
    print("\n검수한 뒤 커밋하세요. 생성물은 초안입니다:")
    for path in made:
        print("  %s" % path)
    print("  deployctl validate %s" % name)
    return 0


def cmd_workflow(args):
    name = args.name
    load(name)
    checkout = Path(args.source) if args.source else WORKSPACES / name
    if not (checkout / ".git").exists():
        raise DeployError("git 체크아웃이 아닙니다: %s" % checkout)
    write_workflow(name, checkout, force=args.force)
    for path in stale_workflows(checkout):
        print("  확인 필요: %s 도 self-hosted 러너를 씁니다." % path)
    print("\n커밋해서 밀면 러너가 배포합니다:")
    print("  cd %s && git add .github/workflows/deploy.yml && git commit && git push" % checkout)
    return 0


def cmd_runner(args):
    name = args.name
    app = load(name)
    if args.remove:
        if not args.yes:
            raise DeployError("러너 등록을 해제합니다. 확인했으면 --yes 를 붙이세요.")
        path = runner_remove(name, app)
        print("해제 완료. 디렉터리는 남깁니다: %s" % path)
        return 0
    path = runner_install(name, app)
    print("러너 준비 완료: %s" % path)
    print("  워크플로의 runs-on 에 이 라벨을 넣으세요:")
    print("    runs-on: [self-hosted, macOS, ARM64, %s]" % name)
    return 0


def cmd_remove(args):
    name = args.name
    app = load(name)
    if not args.yes:
        raise DeployError("되돌릴 수 없는 작업입니다. 확인했으면 --yes 를 붙이세요.")
    print("[1/3] 컨테이너 정리")
    try:
        run(compose_args(name, app, args.source) + ["down", "--remove-orphans"], capture=False)
    except DeployError as e:
        print("     compose down 건너뜀: %s" % str(e).splitlines()[0])
    print("[2/3] Caddy 사이트 해제")
    path = CADDY_SITES / ("%s.caddy" % app["domain"])
    if path.exists():
        stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
        shutil.move(str(path), str(path.with_name("%s.removed.%s" % (path.name, stamp))))
        caddy_reload()
    print("[3/3] DB")
    db, user = db_names(name)
    print("     DB %s 와 유저 %s 는 남겨 둡니다. 지우려면 직접 실행하세요:" % (db, user))
    print("       docker exec -i postgres psql -U postgres -c 'DROP DATABASE %s;' -c 'DROP ROLE %s;'"
          % (db, user))
    print("     매니페스트도 남습니다: %s" % manifest_path(name))
    return 0


def main():
    parser = argparse.ArgumentParser(prog="deployctl", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("init", help="사이트 등록 · 포트 배정 · DB 프로비저닝 "
                                    "(인자 없이 실행하면 하나씩 물어본다)")
    p.add_argument("name", nargs="?")
    p.add_argument("--domain")
    p.add_argument("--port", type=int, help="생략하면 9000번대에서 자동 배정")
    p.add_argument("--repo")
    p.add_argument("--compose",
                   help="source:<파일> 이면 러너 체크아웃 기준, 아니면 ~/srv/<사이트>/ 기준")
    p.add_argument("--health-path")
    p.add_argument("--pool", type=int, help="DB 커넥션 풀 상한 (기본 %d)" % DEFAULT_POOL)
    p.add_argument("--max-upload", type=int, help="업로드 상한(MB)")
    p.add_argument("--db", action="store_true", help="전용 DB·유저를 함께 만든다")
    p.add_argument("--no-clone", action="store_true",
                   help="저장소를 ~/workspaces 로 받아 오지 않는다")
    p.add_argument("--runner", action="store_true", default=None,
                   help="이 저장소 전용 Actions 러너를 등록한다")
    p.add_argument("--deploy", action="store_true", default=None,
                   help="등록이 끝나면 바로 배포한다")
    p.add_argument("--scaffold", action="store_true", default=None,
                   help="없는 Dockerfile·compose 를 claude 로 만든다")
    p.add_argument("--no-push", dest="push", action="store_false", default=None,
                   help="push 하지 않고 이 자리에서 배포한다")
    p.add_argument("--force", action="store_true")
    p.set_defaults(func=cmd_init)

    p = sub.add_parser("validate", help="규칙 위반 검사")
    p.add_argument("name")
    p.add_argument("--source", help="러너 체크아웃 경로 (생략하면 ~/workspaces/<사이트>)")
    p.set_defaults(func=cmd_validate)

    p = sub.add_parser("deploy", help="빌드 · 기동 · Caddy 등록 · HTTPS 확인")
    p.add_argument("name")
    p.add_argument("--source", help="러너 체크아웃 경로 (생략하면 ~/workspaces/<사이트>)")
    p.add_argument("--no-build", action="store_true")
    p.add_argument("--timeout", type=int, default=120)
    p.add_argument("--quiet", action="store_true", help="검사 항목을 출력하지 않는다")
    p.add_argument("--no-rollback", action="store_true",
                   help="헬스체크가 실패해도 이전 이미지로 되돌리지 않는다")
    p.set_defaults(func=cmd_deploy)

    p = sub.add_parser("scaffold", help="없는 Dockerfile·compose 를 만든다 (claude + 빌드 검증)")
    p.add_argument("name")
    p.add_argument("--source", help="체크아웃 경로 (생략하면 ~/workspaces/<사이트>)")
    p.add_argument("--attempts", type=int, default=3, help="Dockerfile 빌드 재시도 횟수")
    p.add_argument("--force", action="store_true", help="이미 있는 파일도 덮어쓴다")
    p.set_defaults(func=cmd_scaffold)

    p = sub.add_parser("workflow", help="배포 워크플로(.github/workflows/deploy.yml) 생성")
    p.add_argument("name")
    p.add_argument("--source", help="체크아웃 경로 (생략하면 ~/workspaces/<사이트>)")
    p.add_argument("--force", action="store_true", help="이미 있는 워크플로도 덮어쓴다")
    p.set_defaults(func=cmd_workflow)

    p = sub.add_parser("runner", help="저장소 전용 Actions 러너 등록·해제 (규칙 8-2)")
    p.add_argument("name")
    p.add_argument("--remove", action="store_true")
    p.add_argument("--yes", action="store_true")
    p.set_defaults(func=cmd_runner)

    p = sub.add_parser("status", help="컨테이너 · Caddy · HTTPS 상태")
    p.add_argument("name", nargs="?")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("remove", help="컨테이너와 Caddy 사이트 해제 (DB는 남긴다)")
    p.add_argument("name")
    p.add_argument("--source")
    p.add_argument("--yes", action="store_true")
    p.set_defaults(func=cmd_remove)

    args = parser.parse_args()
    try:
        return args.func(args)
    except DeployError as e:
        print("오류: %s" % e, file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
