def ask(prompt, default=None, check_fn=None):
    """한 항목씩 묻는다. 빈 입력은 기본값. check_fn 은 오류 메시지나 None 을 돌려준다."""
    suffix = " [%s]" % default if default not in (None, "") else ""
    while True:
        try:
            raw = input("%s%s\n  > " % (prompt, suffix)).strip()
        except EOFError:
            raise DeployError("입력이 끊겼습니다.")
        value = raw or (default or "")
        if not value:
            print("    값이 필요합니다.")
            continue
        problem = check_fn(value) if check_fn else None
        if problem:
            print("    %s" % problem)
            continue
        return value


def ask_yes(prompt, default=True):
    hint = "Y/n" if default else "y/N"
    while True:
        try:
            raw = input("%s [%s]\n  > " % (prompt, hint)).strip().lower()
        except EOFError:
            raise DeployError("입력이 끊겼습니다.")
        if not raw:
            return default
        if raw in ("y", "yes"):
            return True
        if raw in ("n", "no"):
            return False
        print("    y 또는 n 으로 답하세요.")


def dns_hint(domain):
    try:
        addrs = socket.getaddrinfo(domain, None, socket.AF_INET)
    except socket.gaierror:
        return "아직 안 잡힘 — deploy 전까지 A 레코드를 등록하세요."
    return "A 레코드 %s" % ", ".join(sorted({a[4][0] for a in addrs}))


